# Copy to web/.env.local (gitignored). Values come from `supabase status -o env`.
VITE_SUPABASE_URL=http://127.0.0.1:55321
VITE_SUPABASE_ANON_KEY=<ANON_KEY>
# VITE_PERSOCIAL_TZ=UTC

# "Continue as guest" button (Supabase anonymous sign-in). On for local/demo use.
# MUST be false (or removed) in any real deployment, together with
# enable_anonymous_sign_ins = false in Supabase.
VITE_GUEST_LOGIN=true
