# Local Supabase (from `supabase status -o env`)
# API + DB defaults match `supabase start`; uncomment to override
# SUPABASE_URL=http://127.0.0.1:55321
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
SUPABASE_SERVICE_KEY=

# Cloud Supabase (source of truth)
CLOUD_DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
CLOUD_SUPABASE_URL=https://<ref>.supabase.co
CLOUD_SERVICE_KEY=

# Colab notebook secrets (paste both into Colab: key icon -> Secrets)
COLAB_API_URL=https://<ref>.supabase.co/functions/v1/colab-api
COLAB_TOKEN=

# Optional
# PERSOCIAL_TZ=UTC                        # IANA zone for naive CSV timestamps + display
# PERSOCIAL_JUDGE_BASE_URL=http://127.0.0.1:1234/v1
# PERSOCIAL_JUDGE_MODEL=                  # empty = the DB default model
# PERSOCIAL_PACKS=generic                 # comma-separated judge packs: generic, gulf_ar
# SCORING_DEVICE=auto        # auto | cuda | mps | cpu
